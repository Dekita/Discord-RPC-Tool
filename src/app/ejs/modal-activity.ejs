<!-- RENAME ACTIVITY MODAL -->
<div class="modal fade" tabindex="-1" id="edit-activity-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content theme-bg theme-border">
        <div class="modal-header theme-border">
            <h5 class="modal-title"><strong>Rename activity</strong></h5>
            <button type="button" class="btn modal-close" data-bs-dismiss="modal" aria-label="Close">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="modal-body text-start px-4">
            <label class="modal-label" for="app-activity-name">Activity name</label>
            <input type="text" class="form-control form-control-lg form-secondary" id="app-activity-name" placeholder="eg: Ranked matches" spellcheck="false">
            <p class="modal-help mb-0">Only you see this name. It helps you tell your activities apart.</p>
        </div>
        <div class="modal-footer theme-border">
            <button type="button" class="btn btn-success px-4" data-bs-dismiss="modal">Done</button>
        </div>
        </div>
    </div>
</div>

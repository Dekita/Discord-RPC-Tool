<div class="w-100 darker-bg3 titlebar">
    <div class="titlebar-title">
        <small><strong>Discord RPC Tool v<%=version%> <%=title%></strong></small>
    </div>
    <div class="text-end">
        <button class="btn hover-dark" id="btn-app-minimize">
            <i class="fas fa-fw fa-minus"></i>
        </button>
        <button class="btn hover-dark" id="btn-app-maximize">
            <i class="far fa-fw fa-window-maximize"></i>
        </button>
        <button class="btn hover-dark" id="btn-app-exit">
            <i class="fas fa-fw fa-times"></i>
        </button>
    </div>
</div>

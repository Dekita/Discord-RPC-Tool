<div class="activity-layout">
    <div class="activity-editor text-start">
        <div class="editor-scroll thin-scroller">
            <!-- TEXT -->
            <section class="editor-card">
                <div class="editor-card-head">
                    <i class="fas fa-fw fa-align-left"></i><span>Text</span>
                    <div class="editor-card-right" data-bs-toggle="tooltip" title="Show how long the activity has been running, eg: 00:12:47 elapsed">
                        <div class="dekcheckbox multicheck check-dark" id="app-rpc-timestamp-enabled">
                            <ul class="m-0"><li id="app-rpc-timestamp-enabled-text">Show elapsed time</li></ul>
                        </div>
                    </div>
                </div>
                <div class="editor-grid editor-grid-text">
                    <div class="editor-field" data-bs-toggle="tooltip" data-bs-placement="top" title="How the activity is introduced on your profile, eg: Listening to...">
                        <label>Type</label>
                        <select class="dekselect dekselect-secondary" id="activity-type-select">
                            <% for (const type of ['Playing', 'Listening', 'Watching', 'Competing']) { %>
                            <option><%= type %></option>
                            <% } %>
                        </select>
                    </div>
                    <div class="editor-field">
                        <label for="app-details">Line 1</label>
                        <div class="d-flex">
                            <input type="text" class="form-control form-control-sm form-secondary" id="app-details" placeholder="DiscordRPC by DekitaRPG"  data-bs-toggle="tooltip" title="Activity text: Line 1">
                            <button class="btn p-0 no-shadow hover-secondary icon-btn ms-1" id="force-app-details" data-bs-toggle="tooltip" title="Fill from your Developer Portal application description">
                                <i class="fas fa-fw fa-magic"></i>
                            </button>
                        </div>
                    </div>
                    <div class="editor-field">
                        <label for="app-state">Line 2</label>
                        <div class="d-flex">
                            <input type="text" class="form-control form-control-sm form-secondary" id="app-state" placeholder="{servers} Servers | {players} Players"  data-bs-toggle="tooltip" title="Activity text: Line 2">
                            <button class="btn p-0 no-shadow hover-secondary icon-btn ms-1" id="force-app-state" data-bs-toggle="tooltip" title="Fill from your Developer Portal application summary">
                                <i class="fas fa-fw fa-magic"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </section>

            <!-- IMAGES -->
            <section class="editor-card">
                <div class="editor-card-head">
                    <i class="fas fa-fw fa-image"></i><span>Images</span>
                </div>
                <div class="editor-row">
                    <div data-bs-toggle="tooltip" title="Show the large image">
                        <div class="dekcheckbox multicheck check-dark" id="app-rpc-img1-enabled">
                            <ul class="m-0"><li id="app-rpc-img1-enabled-text">Large</li></ul>
                        </div>
                    </div>
                    <div data-bs-toggle="tooltip" data-bs-placement="top" title="Large image asset">
                        <select class="dekselect dekselect-secondary" id="image-select-one">
                            <option>large-image</option>
                        </select>
                    </div>
                    <div data-bs-toggle="tooltip" title="Text shown when hovering the large image">
                        <input type="text" class="form-control form-control-sm form-secondary" id="app-img1-text" placeholder="Hover text...">
                    </div>
                </div>
                <div class="editor-row">
                    <div data-bs-toggle="tooltip" title="Show the small image">
                        <div class="dekcheckbox multicheck check-dark" id="app-rpc-img2-enabled">
                            <ul class="m-0"><li id="app-rpc-img2-enabled-text">Small</li></ul>
                        </div>
                    </div>
                    <div data-bs-toggle="tooltip" data-bs-placement="top" title="Small image asset">
                        <select class="dekselect dekselect-secondary" id="image-select-two">
                            <option>small-image</option>
                        </select>
                    </div>
                    <div data-bs-toggle="tooltip" title="Text shown when hovering the small image">
                        <input type="text" class="form-control form-control-sm form-secondary" id="app-img2-text" placeholder="Hover text...">
                    </div>
                </div>
            </section>

            <!-- BUTTONS -->
            <section class="editor-card">
                <div class="editor-card-head">
                    <i class="fas fa-fw fa-link"></i><span>Buttons</span>
                </div>
                <div class="editor-row">
                    <div data-bs-toggle="tooltip" title="Show button 1">
                        <div class="dekcheckbox multicheck check-dark" id="app-rpc-btn1-enabled">
                            <ul class="m-0"><li id="app-rpc-btn1-enabled-text">Button 1</li></ul>
                        </div>
                    </div>
                    <div data-bs-toggle="tooltip" title="Text shown on button 1">
                        <input type="text" class="form-control form-control-sm form-secondary" id="app-btn1-text" placeholder="Invite">
                    </div>
                    <div data-bs-toggle="tooltip" title="Link opened by button 1">
                        <input type="text" class="form-control form-control-sm form-secondary" id="app-btn1-url" placeholder="https://dekitarpg.com">
                    </div>
                </div>
                <div class="editor-row">
                    <div data-bs-toggle="tooltip" title="Show button 2">
                        <div class="dekcheckbox multicheck check-dark" id="app-rpc-btn2-enabled">
                            <ul class="m-0"><li id="app-rpc-btn2-enabled-text">Button 2</li></ul>
                        </div>
                    </div>
                    <div data-bs-toggle="tooltip" title="Text shown on button 2">
                        <input type="text" class="form-control form-control-sm form-secondary" id="app-btn2-text" placeholder="Website">
                    </div>
                    <div data-bs-toggle="tooltip" title="Link opened by button 2">
                        <input type="text" class="form-control form-control-sm form-secondary" id="app-btn2-url" placeholder="https://dekitarpg.com">
                    </div>
                </div>
            </section>

            <!-- ADVANCED -->
            <details class="editor-card" id="advanced-options">
                <summary><i class="fas fa-fw fa-sliders-h"></i><span>Advanced</span><small>Stats API &middot; update rate</small></summary>
                <div class="editor-advanced">
                    <div class="editor-field" data-bs-toggle="tooltip" title="Custom URL to poll. Should return JSON data, eg: {&quot;players&quot;: 5}">
                        <label for="app-api-url">Stats API URL</label>
                        <input type="text" class="form-control form-control-sm form-secondary" id="app-api-url" placeholder="https://example.com/bot-stats">
                    </div>
                    <div class="editor-field" data-bs-toggle="tooltip" title="How often the Stats API URL is polled (seconds)">
                        <label for="app-api-freq">Poll (s)</label>
                        <input type="number" step="1" min="60" class="form-control form-control-sm form-secondary" id="app-api-freq" placeholder="300">
                    </div>
                    <div class="editor-field" data-bs-toggle="tooltip" title="How often your Discord activity is updated (seconds)">
                        <label for="app-rpc-freq">Update every (s)</label>
                        <input type="number" step="1" min="15" class="form-control form-control-sm form-secondary" id="app-rpc-freq" placeholder="15">
                    </div>
                </div>
            </details>
        </div>

        <div class="action-bar">
            <button id="delete-activity" class="btn icon-btn-lg action-delete" data-bs-toggle="tooltip" title="Delete activity">
                <i class="fas fa-trash-alt"></i>
            </button>
            <button class="btn icon-btn-lg action-portal developer-portal-btn" data-bs-toggle="tooltip" title="Open the Discord Developer Portal">
                <i class="fab fa-discord"></i>
            </button>
            <button id="launch-activity" class="btn btn-success fw-bold launch-btn">
                <i class="fas fa-play me-2"></i><span>Launch activity</span>
            </button>
        </div>
    </div>

    <div class="preview-pane darker-bg1">
        <div class="preview-head">
            <span><i class="fas fa-eye me-1"></i>Discord preview</span>
            <span class="status-pill live d-none" id="preview-live-badge"><i></i><span>LIVE</span></span>
        </div>
        <div class="card profile-card text-start">
            <div class="profile-banner">
                <img src="img/icon.png" class="profile-avatar rounded-circle">
                <span class="profile-status"></span>
            </div>
            <div class="profile-body">
                <h4 class="mb-0 whitney-thick">Username</h4>
                <small class="card-text">I'm a status example!</small>
                <div class="profile-activity">
                    <small class="card-text profile-activity-label"><strong id="app-preview-type">PLAYING A GAME</strong></small>
                    <div class="profile-activity-row">
                        <div class="position-relative" id="preview-image-container">
                            <img src="img/icon.png" class="profile-large-image" id="app-preview-image">
                            <img src="img/icon.png" class="profile-small-image rounded-circle" id="app-preview-image-sm">
                        </div>
                        <div class="profile-activity-text" id="preview-image-textrow">
                            <strong id="app-preview-name">App Name</strong>
                            <small id="app-preview-details">Details</small>
                            <small id="app-preview-state">State</small>
                            <small class="profile-elapsed d-none" id="app-preview-elapsed"><i class="far fa-clock me-1"></i><span>00:00</span> elapsed</small>
                        </div>
                    </div>
                    <a href="#" class="btn btn-sm whitney-thick w-100 mt-2 profile-button" id="preview-btn1">--</a>
                    <a href="#" class="btn btn-sm whitney-thick w-100 mt-2 profile-button" id="preview-btn2">--</a>
                </div>
            </div>
        </div>
        <p class="preview-hint">This is roughly how your profile will look to friends on Discord.</p>
        <%- include('./userfoot.ejs') %>
    </div>
    <div class="toast-container" id="main-toast-container">
        <!-- programatically put bread in the toaster -->
    </div>
</div>

<!-- ACTIVITY CONTEXT MENU: opened from the cog on each activity list item -->
<div class="context-menu d-none" id="activity-context-menu">
    <ul class="list-group list-group-dropdown">
        <li class="list-group-item d-flex hover-dark" data-activity-action="rename">
            <div class="text-start w-100"><span>Rename</span></div>
            <div class="text-end"><i class="fas fa-fw fa-pen"></i></div>
        </li>
        <li class="list-group-item d-flex hover-dark" data-activity-action="duplicate">
            <div class="text-start w-100"><span>Duplicate</span></div>
            <div class="text-end"><i class="fas fa-fw fa-clone"></i></div>
        </li>
        <li class="list-group-item d-flex hover-danger" data-activity-action="delete">
            <div class="text-start w-100"><span>Delete</span></div>
            <div class="text-end"><i class="fas fa-fw fa-trash-alt"></i></div>
        </li>
    </ul>
</div>

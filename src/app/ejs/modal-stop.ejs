<!-- SWITCH LIVE ACTIVITY CONFIRMATION MODAL -->
<!-- shown when picking another activity while one is live on discord -->
<div class="modal fade" tabindex="-1" id="stop-activity-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content theme-bg theme-border">
        <div class="modal-header theme-border">
            <h5 class="modal-title"><strong id="label-stop-activity-title">Switch the live activity?</strong></h5>
            <button type="button" class="btn modal-close" data-bs-dismiss="modal" aria-label="Close">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="modal-body text-start px-4">
            <p class="mb-0" id="label-stop-activity-message"></p>
        </div>
        <div class="modal-footer theme-border">
            <button type="button" class="btn btn-ghost" data-bs-dismiss="modal" id="cancel-change-activity">Keep it</button>
            <button type="button" class="btn btn-primary px-4" id="confirm-change-activity">Switch</button>
        </div>
        </div>
    </div>
</div>

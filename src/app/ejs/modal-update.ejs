<!-- UPDATE DOWNLOADED MODAL -->
<div class="modal fade" tabindex="-1" id="update-modal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content theme-bg theme-border">
        <div class="modal-header theme-border">
            <h5 class="modal-title"><strong><i class="fas fa-gift me-2"></i>Update ready</strong></h5>
            <button type="button" class="btn modal-close" data-bs-dismiss="modal" aria-label="Close">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="modal-body text-start px-4">
            <p class="mb-0">A new version has been downloaded. Restart now to install it, or it will be installed the next time the app closes.</p>
        </div>
        <div class="modal-footer theme-border">
            <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Later</button>
            <button type="button" class="btn btn-success px-4" id="restart-for-update-btn">
                <i class="fas fa-redo-alt me-2"></i>Restart now
            </button>
        </div>
        </div>
    </div>
</div>

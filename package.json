{
    "name": "dekita-rpc-tool",
    "version": "1.0.0",
    "productName": "Discord RPC Tool",
    "description": "Discord RPC Tool written by DekitaRPG",
    "main": "src/main.js",
    "repository": "git@github.com:dekita/discord-rpc-tool",
    "scripts": {
        "start": "electron .",
        "build": "yarn build:windows && yarn build:linux",
        "build:windows": "electron-builder --win --publish never",
        "build:linux": "node scripts/build-linux.js",
        "release": "yarn release:windows && yarn release:linux",
        "release:windows": "electron-builder --win --publish always",
        "release:linux": "node scripts/build-linux.js --publish",
        "test": "node --test \"tests/*.test.js\"",
        "lint": "eslint ."
    },
    "keywords": [],
    "author": {
        "name": "Dekita (DekitaRPG)",
        "email": "dekitarpg@gmail.com"
    },
    "license": "SEE LICENSE IN LICENSE",
    "dependencies": {
        "@fortawesome/fontawesome-free": "5.15.4",
        "chroma-js": "3.2.0",
        "discord-rpc": "^4.0.1",
        "ejs-electron": "^3.0.0",
        "electron-updater": "^6.8.11",
        "json-stringify-pretty-compact": "^3.0.0",
        "luxon": "^3.7.2"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "electron": "^45.2.3",
        "electron-builder": "^26.18.0",
        "eslint": "^9.39.5",
        "globals": "^15.15.0"
    },
    "build": {
        "appId": "com.dekitarpg.rpc",
        "productName": "Discord RPC Tool",
        "directories": {
            "output": "build"
        },
        "files": [
            "src/**/*",
            "!node_modules/@fortawesome/fontawesome-free/{js,svgs,sprites,less,scss,metadata}${/*}",
            "readme.md",
            "LICENSE",
            "package.json"
        ],
        "npmRebuild": false,
        "electronFuses": {
            "runAsNode": false,
            "enableNodeOptionsEnvironmentVariable": false,
            "enableNodeCliInspectArguments": false,
            "enableEmbeddedAsarIntegrityValidation": true,
            "onlyLoadAppFromAsar": true
        },
        "win": {
            "target": "nsis",
            "icon": "src/img/icon.ico"
        },
        "linux": {
            "target": "AppImage",
            "icon": "src/img/icon.png",
            "category": "Utility"
        },
        "nsis": {
            "allowToChangeInstallationDirectory": true,
            "uninstallerIcon": "src/img/icon.ico",
            "installerIcon": "src/img/icon.ico",
            "license": "LICENSE",
            "perMachine": true,
            "oneClick": false
        },
        "appImage": {
            "license": "LICENSE"
        }
    }
}
